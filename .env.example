# Необязательные read-only credentials Bybit Testnet.
# Оставьте оба значения пустыми для public-only запуска.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Оставьте /dev/null при обычном TLS. Для корпоративного proxy укажите
# путь к публичному CA, например ./certs/local-ca.pem.
CUSTOM_CA_FILE=/dev/null

# UID/GID владельца локального каталога data для writable bind mount.
# Узнать значения: id -u и id -g.
BOT_UID=1000
BOT_GID=1000
