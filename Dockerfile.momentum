# Образ Momentum (CM-057): отдельный от legacy, базовые образы закреплены по digest.
# Обновление digest — отдельный PR с проверкой сборки и smoke.
FROM golang:1.26.11-bookworm@sha256:dc40a13b61304647ed7e5d581d246b86413dfc29d63c6d018310feb93cd98fc0 AS build
WORKDIR /src
# GOTOOLCHAIN=local: toolchain из go.mod уже в образе, сборка его не скачивает.
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-trimpath
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY cmd ./cmd
COPY internal ./internal
RUN go build -ldflags="-s -w" -o /out/momentum ./cmd/momentum

# distroless nonroot: без shell и пакетного менеджера, UID 65532.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/momentum /usr/local/bin/momentum
COPY configs/ /etc/momentum/
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/momentum"]
