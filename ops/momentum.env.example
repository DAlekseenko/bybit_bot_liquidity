# Пример env для ops/docker-compose.momentum.yml. Скопируйте в ops/momentum.env
# (файл не коммитится) и задайте свой пароль. Только символы [A-Za-z0-9._-]:
# пароль подставляется в DSN без URL-экранирования.
MOMENTUM_POSTGRES_PASSWORD=

# Отправка заявок по умолчанию выключена: этот Compose не передаёт контейнеру
# никаких ключей Bybit и запускает только публичный сбор collect-once.
# Testnet-ключи (MOMENTUM_TESTNET_API_KEY/SECRET) подключаются в CM-054 и
# только для Testnet; Mainnet этим файлом не включается.
